<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlbumApp1._0._1.Views.Basic.Photos.InformationAboutPhotography"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlbumApp1._0._1.Views.Basic.Photos"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:photos="using:AlbumApp1._0._1.ViewModels.Basic.Photos" 
    xmlns:vm="using:AlbumApp1._0._1.ViewModels.Basic.Photos" 

    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <Grid Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>
                <TextBox Height="25"  Margin="10" Grid.Row="0" Text="{x:Bind ViewModel.PhotoName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                <TextBox Height="25" Margin="10" Grid.Row="1" IsReadOnly="True" Text="{x:Bind ViewModel.Username}"/>

                <Grid  Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="10" Grid.Row="0" Orientation="Horizontal">
                        <ComboBox Text="{x:Bind ViewModel.InputObjectName,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.ObjectCollection}" SelectedValue="{x:Bind ViewModel.NameObject, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedValuePath="НазваниеОбъекта" DisplayMemberPath="НазваниеОбъекта" IsEditable="True" Width="200" PlaceholderText="Объект"/>
                        <Button Command="{x:Bind ViewModel.AddObjectCommand}"   Content="+"/>
                        <Button Command="{x:Bind ViewModel.DeleteObjectCommand}"   Content="-"/>
                    </StackPanel>
                    <StackPanel Margin="10" Grid.Row="1" Orientation="Horizontal">
                        <ComboBox Text="{x:Bind ViewModel.InputPlaceName,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.PlaceCollection}" SelectedValue="{x:Bind ViewModel.NamePlace, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedValuePath="НазваниеМеста" DisplayMemberPath="НазваниеМеста" IsEditable="True" Width="200" PlaceholderText="Место"/>
                        <Button Command="{x:Bind ViewModel.AddPlaceCommand}"   Content="+"/>
                        <Button Command="{x:Bind ViewModel.DeletePlaceCommand}"   Content="-"/>
                    </StackPanel>
                    <StackPanel Margin="10" Grid.Row="3" Orientation="Horizontal">
                        <ComboBox  Text="{x:Bind ViewModel.InputAccessoryName,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.AccessoryCollection}" SelectedValue="{x:Bind ViewModel.NameAccessory, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedValuePath="НазваниеОборудования" DisplayMemberPath="НазваниеОборудования" IsEditable="True" Width="200" PlaceholderText="Оборудование"/>
                        <Button Command="{x:Bind ViewModel.AddAccessoryCommand}"   Content="+"/>
                        <Button Command="{x:Bind ViewModel.DeleteAccessoryCommand}"  Content="-"/>
                    </StackPanel>
                </Grid>
              
                <ComboBox Grid.Row="3" ItemsSource="{x:Bind ViewModel.StyleCollection}" SelectedValue="{x:Bind ViewModel.CodeStyle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" SelectedValuePath="КодСтиля" DisplayMemberPath="НазваниеСтиля" Width="233" Margin="10 "  PlaceholderText="Стиль"/>
                <NumberBox Grid.Row="4" Text="{x:Bind ViewModel.Unique, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="10" Minimum="0" Maximum="10"  ValidationMode="InvalidInputOverwritten" SpinButtonPlacementMode="Compact"   PlaceholderText="Уникальность (0-10)"/>

            </Grid>
          
            
        </Grid>
        <Grid Margin="10" VerticalAlignment="Top" Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBox Width="233" Grid.Row="0" AcceptsReturn="True" Text="{x:Bind ViewModel.Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" TextWrapping="Wrap" Header="Описание"/>

            <Button Grid.Row="1" Command="{x:Bind ViewModel.ChangePhotoCommand}" Grid.Column="0" Width="200" Margin="20" Content="Изменить" />
            <Button Grid.Row="1" Command="{x:Bind ViewModel.DeletePhotoCommand}" Grid.Column="1" Width="200" Margin="20"  Content="Удалить" />
        </Grid>
     
    </Grid>
</Page>
