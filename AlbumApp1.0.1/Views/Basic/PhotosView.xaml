<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlbumApp1._0._1.Views.Basic.PhotosView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlbumApp1._0._1.Views.Basic"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AlbumApp1._0._1.Models.Tables"
    xmlns:vmm="using:AlbumApp1._0._1.ViewModels.Basic"

    mc:Ignorable="d">
    <Page.Resources>
        <vmm:PhotosViewModel x:Key="PhotosViewModel"/>


        <DataTemplate x:Key="ImageTemplate" x:DataType="vm:Фотографии" >
            <Grid  Width="400" Height="Auto">
               
                <Image Height="Auto" Source="{x:Bind Image,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Stretch="UniformToFill"/>
                <StackPanel>
                    <Button DataContext="{StaticResource PhotosViewModel}" Content="Детальная информация" Command="{Binding OpenPhotoCommand}"/>
                </StackPanel>
            </Grid>

            </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Grid Margin="10" CornerRadius="10" Padding="20" Background="DarkSlateGray">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                   
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ComboBox VerticalAlignment="Center" Grid.Column="0" PlaceholderText="Дата" >
                            <ComboBoxItem Content="По возрастанию"/>
                            <ComboBoxItem Content="По убыванию"/>
                        </ComboBox>
                        <ComboBox VerticalAlignment="Center" Grid.Column="1" PlaceholderText="Уникальность" >
                            
                        </ComboBox>
                    </Grid>
                        
              
                </Grid>

                <Grid Margin="10" CornerRadius="10"  Padding="20" Height="200" Width="Auto" Background="DarkSlateGray" >
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                      
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <ComboBox Grid.Column="0" PlaceholderText="Объект"  >

                        </ComboBox>
                        <ComboBox Grid.Column="1" PlaceholderText="Стиль">

                        </ComboBox>
                        <ComboBox Grid.Column="2" PlaceholderText="Автор">

                        </ComboBox>
                    </Grid>
                       
                    
                
                </Grid>
            </StackPanel>
            <Grid Grid.Column="1" Padding="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                   
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
               <Button IsEnabled="{x:Bind ViewModel.Include,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Command="{x:Bind ViewModel.AddPhotoWindowCommand}" Width="149" Height="37" Grid.Column="1" HorizontalAlignment="Center" Grid.Row="0" CornerRadius="19" Content="Добавить"/>

                <AutoSuggestBox Width="180" Height="32" Grid.Column="1" VerticalAlignment="Center"  Grid.Row="1" PlaceholderText="Найти"/>
                <Button IsEnabled="{x:Bind ViewModel.Include,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Command="{x:Bind ViewModel.LoadPhotosCommand}" Width="149" Height="37" Grid.Column="1" HorizontalAlignment="Center" Grid.Row="2" CornerRadius="19" Content="Загрузить"/>

            </Grid>
          
              
           
        </Grid>
        <Grid Grid.Row="1">

            <GridView  SelectedItem="{x:Bind ViewModel.Photos, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsItemClickEnabled="True" ItemTemplate="{StaticResource ImageTemplate}" ItemsSource="{x:Bind ViewModel.photoService.PhotographyCollection, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Center"  Margin="10"  >
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <Setter Property="Margin" Value="5, 5, 5, 5"/>
                    </Style>
                </GridView.ItemContainerStyle>
                
                <GridView.ItemsPanel >
                    
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid CacheMode="BitmapCache"   MaximumRowsOrColumns="3" Orientation="Horizontal"/>
                        
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

               
            </GridView>
                
        </Grid>
    </Grid>
  
</Page>
